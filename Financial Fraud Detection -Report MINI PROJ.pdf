621 0 obj
<<
/Type /StructElem
/S /H1
/P 254 0 R
/T (        Total_Transactions = COUNT\(Table1[Transaction_ID]\)      2. Total Transaction Amount        Total_Trans_Amnt = SUM\(Table1[Trans_Amnt \(M\)]\)      3. Total Normal Transaction        Total_Normal_Trans = CALCULATE\(COUNT\(Table1[Transaction_ID]\),Table1[Fraud_Label]="Normal"\)    4. Total Fraud Transaction        Total_Fraud_Trans = CALCULATE\(COUNT\(Table1[Transaction_ID]\),Table1[Fraud_Label]="Fraud"\)    5. Total Customers        Total_Customers = DISTINCTCOUNT\(Table1[Customer_ID]\)    6. Total Fraud Transaction Amount        Fraud_Trans_Amnt = CALCULATE\(SUM\(Table1[Trans_Amnt \(M\)]\),Table1[Fraud_Label]="Fraud"\)    7. Fraud Rate Percentage       Fraud_Rate% = DIVIDE\([Total_Fraud_Trans],[Total_Transactions],0\)     8. Total Merchant        Total_Merchants = DISTINCTCOUNT\(Table1[Merchant_ID]\)     9. Average Transaction Amount        Avg_Trans_Amnt = AVERAGE\(Table1[Trans_Amnt \(M\)]\) )
/E (        Total_Transactions = COUNT\(Table1[Transaction_ID]\)      2. Total Transaction Amount        Total_Trans_Amnt = SUM\(Table1[Trans_Amnt \(M\)]\)      3. Total Normal Transaction        Total_Normal_Trans = CALCULATE\(COUNT\(Table1[Transaction_ID]\),Table1[Fraud_Label]="Normal"\)    4. Total Fraud Transaction        Total_Fraud_Trans = CALCULATE\(COUNT\(Table1[Transaction_ID]\),Table1[Fraud_Label]="Fraud"\)    5. Total Customers        Total_Customers = DISTINCTCOUNT\(Table1[Customer_ID]\)    6. Total Fraud Transaction Amount        Fraud_Trans_Amnt = CALCULATE\(SUM\(Table1[Trans_Amnt \(M\)]\),Table1[Fraud_Label]="Fraud"\)    7. Fraud Rate Percentage       Fraud_Rate% = DIVIDE\([Total_Fraud_Trans],[Total_Transactions],0\)     8. Total Merchant        Total_Merchants = DISTINCTCOUNT\(Table1[Merchant_ID]\)     9. Average Transaction Amount        Avg_Trans_Amnt = AVERAGE\(Table1[Trans_Amnt \(M\)]\) )
/Pg 28 0 R
/K [7]
>>
endobj
